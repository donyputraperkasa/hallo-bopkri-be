PORT=4000
DATABASE_URL="mysql://root@localhost:3306/hallo_bopkri"
JWT_SECRET="ganti-dengan-random-secret-minimal-32-karakter"
JWT_EXPIRES_IN="8h"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ganti-password-admin-minimal-10-karakter"

DIRECTOR_USERNAME="director"
DIRECTOR_PASSWORD="ganti-password-director"

MANAGER_PASSWORD="ganti-password-default-manager"
MGR_PENDIDIKAN_USERNAME="mgr_pendidikan"
MGR_PENDIDIKAN_PASSWORD="ganti-password-mgr-pendidikan"
MGR_KEUANGAN_USERNAME="mgr_keuangan"
MGR_KEUANGAN_PASSWORD="ganti-password-mgr-keuangan"
MGR_PSDM_USERNAME="mgr_psdm"
MGR_PSDM_PASSWORD="ganti-password-mgr-psdm"
MGR_HUMAS_USERNAME="mgr_humas"
MGR_HUMAS_PASSWORD="ganti-password-mgr-humas"
MGR_ASSET_USERNAME="mgr_asset"
MGR_ASSET_PASSWORD="ganti-password-mgr-asset"
MGR_LAINNYA_USERNAME="mgr_lainnya"
MGR_LAINNYA_PASSWORD="ganti-password-mgr-lainnya"
CORS_ORIGIN="http://localhost:3000"
ENABLE_SWAGGER=true
UPLOAD_DIR="uploads"

# Email SMTP (kosongkan SMTP_HOST untuk menonaktifkan email)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="username-smtp"
SMTP_PASSWORD="password-smtp"
SMTP_FROM="Hallo BOPKRI <no-reply@example.com>"
ADMIN_NOTIFICATION_EMAIL="admin@example.com"

# Gateway WhatsApp harus menerima JSON: { "target": "...", "message": "..." }
WHATSAPP_GATEWAY_URL="https://gateway.example.com/send"
WHATSAPP_GATEWAY_TOKEN="token-gateway"
ADMIN_NOTIFICATION_WHATSAPP="6281234567890"
