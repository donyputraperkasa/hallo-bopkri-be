PORT=4000
DATABASE_URL="mysql://root@localhost:3306/hallo_bopkri"
JWT_SECRET="ganti-dengan-random-secret-minimal-32-karakter"
JWT_EXPIRES_IN="8h"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ganti-password-admin-minimal-10-karakter"
CORS_ORIGIN="http://localhost:3000"
ENABLE_SWAGGER=true
UPLOAD_DIR="uploads"

# Email SMTP (kosongkan SMTP_HOST untuk menonaktifkan email)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="username-smtp"
SMTP_PASSWORD="password-smtp"
SMTP_FROM="Hallo BOPKRI <no-reply@example.com>"
ADMIN_NOTIFICATION_EMAIL="admin@example.com"

# Gateway WhatsApp harus menerima JSON: { "target": "...", "message": "..." }
WHATSAPP_GATEWAY_URL="https://gateway.example.com/send"
WHATSAPP_GATEWAY_TOKEN="token-gateway"
ADMIN_NOTIFICATION_WHATSAPP="6281234567890"
